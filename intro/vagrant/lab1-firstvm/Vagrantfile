Vagrant.configure("2") do |config|
  config.vm.box = "bento/debian-13"
  config.vm.box_url = "https://portal.cloud.hashicorp.com/vagrant/discover/bento/debian-13"

  # VM 1
  config.vm.define "tat-nguy" do |tat|
    tat.vm.hostname = "Server"
    tat.vm.network "private_network", ip: "192.168.56.110"
    tat.vm.provider :virtualbox do |vb|
      vb.memory = 512
      vb.cpus = 1
    end
  end

  # VM 2
  config.vm.define "hadrien" do |hadrien|
    hadrien.vm.hostname = "ServerWorker"
    hadrien.vm.network "private_network", ip: "192.168.56.111"
    hadrien.vm.provider :virtualbox do |vb|
      vb.memory = 512
      vb.cpus = 1
    end
  end

end
